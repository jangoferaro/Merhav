{
  "name": "encore",
  "private": true,
  "version": "0.2.0",
  "description": "ENCORE — מנוע להגדלת קהל: הציבור מקדם הופעות ומרוויח מכל כרטיס",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning src/seed.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "start:staging": "node --no-warnings=ExperimentalWarning src/seed-if-empty.js && node --no-warnings=ExperimentalWarning src/server.js",
    "ops:qa": "node --no-warnings=ExperimentalWarning ops/qa.mjs",
    "ops:load": "node --no-warnings=ExperimentalWarning ops/load.mjs",
    "ops:restore": "node --no-warnings=ExperimentalWarning ops/restore.mjs"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "node-forge": "1.3.1",
    "pngjs": "7.0.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "axe-core": "^4.10.2"
  }
}
