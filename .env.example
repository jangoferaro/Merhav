# מפתח ה-API שלכם מ-console.anthropic.com
ANTHROPIC_API_KEY=

# כתובת בסיס אופציונלית — השאירו ריק כדי להשתמש ב-API הרשמי של
# Anthropic (https://api.anthropic.com). שנו רק אם יש לכם פרוקסי
# תואם-Anthropic משלכם (למשל שער Bedrock/Vertex).
ANTHROPIC_API_BASE_URL=

# שמות המודלים לשיחה ולחילוץ הזיכרון. ברירת המחדל כבר מוגדרת למודלים
# אמיתיים וזמינים כרגע (Sonnet 5 לשיחה, Haiku לחילוץ זיכרון זול ומהיר).
CHAT_MODEL=claude-sonnet-5
MEMORY_MODEL=claude-haiku-4-5-20251001

# פורט אופציונלי (ברירת מחדל 3000, ואם תפוס מחפש אוטומטית פורט פנוי)
PORT=3000
