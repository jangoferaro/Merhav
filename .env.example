# SAFE WALK - Phase 0 prototype
#
# Everything below is OPTIONAL. With no .env at all the prototype runs fully:
# routing uses the built-in Tel Aviv street graph, signals come from the seeded
# mock feature store, and explanations use the deterministic template engine.
#
# The product decision NEVER depends on any of these keys. Per the spec
# (section Yod - AI Explanation Engine), the LLM only rephrases reason codes
# that the Safety Engine already approved.

PORT=8787

# --- AI explanation (optional) -------------------------------------------
# Without a key, explanations come from server/explain/template.ts, which is
# the required deterministic fallback (spec section Yod, "Fallback without LLM").
ANTHROPIC_API_KEY=
EXPLANATION_MODEL=claude-haiku-4-5-20251001

# --- Routing provider (optional) -----------------------------------------
# ROUTING_PROVIDER=graph   # built-in Tel Aviv graph (default, no key needed)
# ROUTING_PROVIDER=mapbox  # not implemented in Phase 0; adapter seam only
MAPBOX_ACCESS_TOKEN=
