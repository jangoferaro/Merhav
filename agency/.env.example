# ---------------------------------------------------------------------------
# Every key here is optional. A provider without its key falls back to the
# deterministic offline implementation, so the company runs either way.
# ---------------------------------------------------------------------------

# Brains — the agents' reasoning and all generated copy
ANTHROPIC_API_KEY=
AGENCY_LLM_MODEL=claude-sonnet-5

# Image generation
EROMIFY_API_KEY=                 # eromify.com — set providers.image = "eromify"
EROMIFY_API_URL=https://api.eromify.com/v1/generate
EROMIFY_UNIT_COST=0.08
IMAGE_API_URL=                   # any OpenAI/Replicate-style endpoint (providers.image = "http")
IMAGE_API_KEY=
IMAGE_API_MODEL=flux-1.1-pro

# Voice
ELEVENLABS_API_KEY=

# Publishing (providers.social = "live"); each platform works on its own
IG_ACCESS_TOKEN=
IG_USER_ID=
TIKTOK_ACCESS_TOKEN=
X_BEARER_TOKEN=
YOUTUBE_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=
FANVUE_API_KEY=

# Billing
STRIPE_API_KEY=

# Run control
AGENCY_SEED=1337
AGENCY_CONFIG=                   # path to an alternative company.toml
AGENCY_ADULT_TIER=               # "1" — required *in addition to* policy.allow_adult_tier
